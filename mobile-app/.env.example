# ============================================
# MusAI 缪斯智音 - 移动端环境变量配置模板
# ============================================
# 快速开始：
#   cp .env.example .env
#   按需修改 API 地址
# ============================================
# ⚠️ 安全警告：
#   1. 永远不要将 .env 文件提交到版本控制
#   2. 敏感信息请使用 Expo SecureStore 存储
# ============================================

# 运行环境 (development | production)
NODE_ENV=development

# 后端 API 基础地址
# iOS 模拟器：http://localhost:25101/api
# Android 模拟器：http://10.0.2.2:25101/api
# 生产环境：https://d-music.yyc3.top/api
EXPO_PUBLIC_API_URL=http://localhost:25101/api

# WebSocket 地址
# 生产环境：wss://d-music.yyc3.top
EXPO_PUBLIC_WS_URL=ws://localhost:25101

# 应用名称
EXPO_PUBLIC_APP_NAME=MusAI

# 应用版本
EXPO_PUBLIC_APP_VERSION=1.0.0
