# ============================================
# MusAI 缪斯智音 - 后端环境变量配置模板
# ============================================
# 快速开始：
#   cp .env.example .env
#   修改 DB_PASSWORD 和 JWT_SECRET 后即可启动
# ============================================
# ⚠️ 安全警告：
#   1. 永远不要将 .env 文件提交到版本控制
#   2. 生产环境 JWT_SECRET 必须 >= 32 字符
#   3. 数据库密码不能为空
# ============================================

# 运行环境 (development | production | test)
NODE_ENV=development

# 服务器端口（遵循五高架构规范：25101 = 后端服务-音乐模块-实例1）
PORT=25101

# 前端地址（用于CORS和WebSocket）
# 本地开发：http://localhost:20101
# 生产环境：https://d-music.yyc3.top
FRONTEND_URL=http://localhost:20101

# ============================================
# 数据库配置（必填）
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=musai
DB_USER=musai_app
# ⚠️ DB_PASSWORD 不能为空，否则服务启动失败
DB_PASSWORD=your_secure_db_password_here
DB_POOL_MAX=10

# ============================================
# Redis 缓存配置（可选，但推荐启用）
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================
# JWT 认证配置（必填）
# ============================================
# ⚠️ JWT_SECRET 必须 >= 32 字符
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_long
JWT_EXPIRES_IN=7d

# ============================================
# 文件上传配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# API 限流配置
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
