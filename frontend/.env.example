# ============================================
# MusAI 缪斯智音 - 前端环境变量配置模板
# ============================================
# 快速开始：
#   cp .env.example .env
#   按需修改下方配置
# ============================================
# ⚠️ 安全警告：
#   1. 永远不要将 .env 文件提交到版本控制
#   2. 所有变量必须以 VITE_ 前缀开头才能在客户端使用
# ============================================

# 运行环境 (development | production | test)
NODE_ENV=development

# 后端 API 基础地址
# 本地开发：http://localhost:25101/api
# 生产环境：https://d-music.yyc3.top/api
VITE_API_BASE_URL=http://localhost:25101/api

# WebSocket 地址
# 本地开发：ws://localhost:25101
# 生产环境：wss://d-music.yyc3.top
VITE_WS_URL=ws://localhost:25101

# 应用名称
VITE_APP_NAME=MusAI

# 应用版本
VITE_APP_VERSION=1.0.0
