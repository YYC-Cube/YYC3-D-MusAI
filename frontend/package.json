  "description": "MusAI 缪斯智音 - 前端（基于shadcn/ui + Zustand + Tailwind v4）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 20101",
    "build": "vite build",
    "preview": "vite preview --port 20102",
