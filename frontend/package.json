    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4",
